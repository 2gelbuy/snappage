{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": "."
    },
    "include": [
        ".wxt/wxt.d.ts",
        "entrypoints/**/*",
        "components/**/*",
        "hooks/**/*",
        "utils/**/*",
        "assets/**/*"
    ]
}
